# Copy to .env — the pipeline runs with ALL of these empty (free mode).
# Only fill in what you actually have.

# ── FREE keys (just need account registration, no credit card) ─────────────
# Dutch Chamber of Commerce: developer.kvk.nl
KVK_API_KEY=

# UK Companies House: developer.company-information.service.gov.uk
COMPANIES_HOUSE_API_KEY=

# ── Database (SQLite is default — zero setup needed) ───────────────────────
DATABASE_URL=sqlite:///crm_pipeline.db

# ── Optional paid upgrades (leave blank to skip) ───────────────────────────
WAPPALYZER_API_KEY=
BUILTWITH_API_KEY=
APOLLO_API_KEY=

# ── Proxy list (leave blank to run without proxies) ────────────────────────
# Format: http://user:pass@host:port,http://user:pass@host2:port
PROXY_LIST=
